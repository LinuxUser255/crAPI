IDENTITY_SERVER_PORT=8090
COMMUNITY_SERVER_PORT=8087
WORKSHOP_SERVER_PORT=8000
CHATBOT_SERVER_PORT=5002
ENABLE_SHELL_INJECTION=false
ENABLE_LOG4J=false
# OAuth 2.0 authorization server in crapi-identity. The flow itself is standard;
# the teaching weaknesses get their own toggles in a later phase.
ENABLE_OAUTH=true
# OAuth scope enforcement on delegated tokens. Leave this unset for the intended
# inconsistency: Workshop enforces write:orders on orders, Community does not.
# Set true to enforce in both services ("secure mode"), or false to disable both.
# ENABLE_OAUTH_SCOPE_CHECK=true
LISTEN_IP="127.0.0.1"
TLS_ENABLED=true
VERSION=latest
LOG_LEVEL=INFO