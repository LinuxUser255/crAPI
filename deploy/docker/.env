IDENTITY_SERVER_PORT=8090
COMMUNITY_SERVER_PORT=8087
WORKSHOP_SERVER_PORT=8000
CHATBOT_SERVER_PORT=5002
ENABLE_SHELL_INJECTION=false
ENABLE_LOG4J=false
# OAuth 2.0 authorization server in crapi-identity.
ENABLE_OAUTH=true
# OAuth mode: one flag for the whole lab. "secure" (default) runs OAuth by the
# book. "vulnerable" opens all the OAuth challenges at once (loose redirect_uri
# matching, scope not enforced, ...). See docs/challenges.md and docs/oauth-plan.md.
OAUTH_MODE=vulnerable
LISTEN_IP="127.0.0.1"
TLS_ENABLED=true
VERSION=latest
LOG_LEVEL=INFO